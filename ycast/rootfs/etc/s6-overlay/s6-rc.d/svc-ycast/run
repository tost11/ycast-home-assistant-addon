#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Add-on: YCast - YCast Service
# ==============================================================================

YCAST_PORT="${YCAST_PORT:-80}"

# Ensure stations file exists
if [[ ! -f /data/stations.yml ]]; then
    cp /opt/ycast/stations.yml /data/stations.yml
    bashio::log.info "Created default stations.yml"
fi

bashio::log.info "Starting YCast (port ${YCAST_PORT})..."
exec python3 -m ycast -p "${YCAST_PORT}" -c /data/stations.yml
